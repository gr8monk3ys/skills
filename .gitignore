# macOS
.DS_Store

# Editor
.idea/
# Include VS Code settings for consistent dev experience
# but exclude workspace-specific files
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Local settings (users should not commit these)
.claude/settings.local.json

# Node
node_modules/
package-lock.json

# Session exhaust from AI tooling
.superpowers/
docs/superpowers/
.claude/handoffs/*
!.claude/handoffs/.gitkeep
.claude/logs/*
!.claude/logs/.gitkeep
